Windows Registry Editor Version 5.00

; Registers a "ssh:" URL protocol handler for the current user, pointing
; at ssh-protocol-handler.vbs (which opens Windows Terminal, falling back
; to Command Prompt). Before importing this file:
;
;   1. Place ssh-protocol-handler.vbs somewhere permanent, e.g.
;      C:\Tools\piops\ssh-protocol-handler.vbs
;   2. Replace EVERY occurrence of C:\\Tools\\piops below with
;      that actual path, using double backslashes (\\) exactly as shown.
;   3. Save this file, then double-click it and confirm the prompt.
;
; After that, "Open in local terminal" with Settings set to "System
; default" will open a real native terminal (Windows Terminal if
; installed, Command Prompt otherwise) running ssh, instead of the
; browser having nothing to do with the link.
;
; If something else on your system already handles ssh:// links (some
; Git-for-Windows installs register their own), importing this will
; silently replace that registration with this one.

[HKEY_CURRENT_USER\Software\Classes\ssh]
@="URL:SSH Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\ssh\shell]

[HKEY_CURRENT_USER\Software\Classes\ssh\shell\open]

[HKEY_CURRENT_USER\Software\Classes\ssh\shell\open\command]
@="wscript.exe \"C:\\\\Tools\\\\piops\\\\ssh-protocol-handler.vbs\" \"%1\""
