Windows Registry Editor Version 5.00

; Registers a "putty:" URL protocol handler for the current user, pointing
; at putty-protocol-handler.vbs. Before importing this file:
;
;   1. Place putty-protocol-handler.vbs somewhere permanent, e.g.
;      C:\Tools\pi-fleet-dashboard\putty-protocol-handler.vbs
;   2. Replace EVERY occurrence of C:\\Tools\\pi-fleet-dashboard below with
;      that actual path, using double backslashes (\\) exactly as shown.
;   3. Save this file, then double-click it and confirm the prompt.
;
; After that, links like putty:pi@192.168.1.50:22 (which is what this
; dashboard generates when you set "Open in local terminal" to PuTTY in
; Settings) will launch PuTTY directly.

[HKEY_CURRENT_USER\Software\Classes\putty]
@="URL:PuTTY SSH Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\putty\shell]

[HKEY_CURRENT_USER\Software\Classes\putty\shell\open]

[HKEY_CURRENT_USER\Software\Classes\putty\shell\open\command]
@="wscript.exe \"C:\\\\Tools\\\\pi-fleet-dashboard\\\\putty-protocol-handler.vbs\" \"%1\""
